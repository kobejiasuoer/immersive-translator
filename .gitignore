.build/
.swiftpm/
DerivedData/
dist/
release/
*.xcuserstate
.DS_Store

# Xcode / SwiftPM local state
Package.resolved
xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/

# macOS artifacts
*.app
*.dSYM

# Local secrets and diagnostics
.env
.env.*
*.log
diagnostic.log

# Local installer output (built by tauri, not committed)
release-builds/

# 根目录发布产物归档（本地留档，正式分发走 GitHub Release）
release-v*/

# [SPIKE] Edge TTS 探针：音频样本绝不入库（探针脚本随仓库）
.spike/*.mp3

# WorkBuddy workspace memory (local only)
.workbuddy/

# Temporary files
*.tmp
*.swp

# ZCode 本地会话状态
.zcode/

# AI 工具本地状态（会话/技能/浏览器抓取残留，纯本机，不入公开仓库）
.agents/
.claude/
.taste-skill/
.playwright-cli/
skills-lock.json
prototypes/.taste-skill/
prototypes/.shots*.png

# 官网整包导出（website/ 源码入库，zip 留档不入）
website.zip

# 私有商业文档（服务端设计/定价/商标备案等，只留本机、永不入库）
# 公开仓库是客户端开源的一部分；这里的东西不随仓库走，注意自行备份
docs/private/
.tmp-assets/

# mobile-v3 设计迭代过程截图（round1/round2/audit 等 91M·777 张，纯本地工作证据，文档与代码零引用；定稿决策已沉淀进 docs/mobile-v3-*.md）
prototypes/shots/mobile-v3/

# Python 字节码缓存（make-icon.py 等脚本的运行残留）
__pycache__/
*.pyc
