{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://immersive-translator.local/contracts/reading-room.schema.json",
  "title": "沉浸阅读室数据契约（Mac / Windows 共享）",
  "description": "阅读室的文章、句对、生词（SRS）与阅读设置。Windows 落盘为 reader_articles.json / reader_vocab.json（顶层各带 schemaVersion），Mac 端按同一 schema 实现。",
  "version": "1.0.0",
  "$defs": {
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "description": "主版本号不同视为不兼容：读取方应向用户友好提示升级，不得静默失败或清空数据。"
    },
    "articleSourceType": {
      "type": "string",
      "enum": ["paste", "url", "epub", "pdf"]
    },
    "sentenceZhState": {
      "type": "string",
      "enum": ["pending", "done", "failed", "edited"]
    },
    "sentencePair": {
      "type": "object",
      "required": ["idx", "paragraphIdx", "en", "zh", "zhState"],
      "properties": {
        "idx": { "type": "integer", "minimum": 0, "description": "全文句序号，从 0" },
        "paragraphIdx": { "type": "integer", "minimum": 0 },
        "en": { "type": "string" },
        "zh": { "type": ["string", "null"], "description": "null = 尚未翻译" },
        "zhState": { "$ref": "#/$defs/sentenceZhState" },
        "revealed": { "type": "boolean", "description": "遮罩模式下是否已揭开" }
      }
    },
    "articleProgress": {
      "type": "object",
      "required": ["sentenceIdx", "percent", "secondsListened"],
      "properties": {
        "sentenceIdx": { "type": "integer", "minimum": 0 },
        "percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "secondsListened": { "type": "number", "minimum": 0 }
      }
    },
    "readerSettings": {
      "type": "object",
      "description": "文章记录里允许只携带部分字段（覆盖全局默认）；全局默认文件必须全量。",
      "required": [],
      "properties": {
        "contrastMode": { "type": "string", "enum": ["en", "dual", "zh"] },
        "maskTranslation": { "type": "boolean" },
        "maskStyle": { "type": "string", "enum": ["blank", "frost"], "description": "遮罩样式：blank=留白显影，frost=毛玻璃" },
        "showProgress": { "type": "boolean" },
        "zenMode": { "type": "boolean" },
        "theme": { "type": "string", "enum": ["light", "dark", "sepia", "oled"] },
        "fontSize": { "type": "number", "minimum": 14, "maximum": 24 },
        "lineHeight": { "type": "number", "minimum": 1, "maximum": 2.4 },
        "fontPair": { "type": "string", "enum": ["serif", "sans"] },
        "voice": { "type": "string", "description": "系统 TTS 音色名；空串 = 引擎默认" },
        "rate": { "type": "number", "minimum": 0.5, "maximum": 2 },
        "sentencePauseMs": { "type": "number", "minimum": 0, "maximum": 2000 },
        "shadowingMode": { "type": "boolean" }
      }
    },
    "article": {
      "type": "object",
      "required": [
        "id", "title", "titleCnState", "sourceType", "wordCount",
        "createdAt", "lastReadAt", "progress", "sentences"
      ],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "description": "英文标题" },
        "titleCn": { "type": "string", "description": "中文副标题" },
        "titleCnState": { "$ref": "#/$defs/sentenceZhState" },
        "sourceUrl": { "type": "string" },
        "sourceType": { "$ref": "#/$defs/articleSourceType" },
        "level": { "type": "string", "description": "如 \"B1 入门\"" },
        "wordCount": { "type": "integer", "minimum": 0 },
        "createdAt": { "type": "integer", "description": "Unix 毫秒" },
        "lastReadAt": { "type": "integer", "description": "Unix 毫秒" },
        "progress": { "$ref": "#/$defs/articleProgress" },
        "sentences": { "type": "array", "items": { "$ref": "#/$defs/sentencePair" } },
        "settings": { "$ref": "#/$defs/readerSettings" }
      }
    },
    "vocabSrsState": {
      "type": "object",
      "required": ["ease", "intervalDays", "reps", "dueAt", "lapses"],
      "properties": {
        "ease": { "type": "number" },
        "intervalDays": { "type": "number", "minimum": 0 },
        "reps": { "type": "integer", "minimum": 0 },
        "dueAt": { "type": "integer", "description": "Unix 毫秒；到期判定唯一依据" },
        "lapses": { "type": "integer", "minimum": 0 }
      }
    },
    "vocabWord": {
      "type": "object",
      "required": ["id", "word", "senses", "source", "srs", "addedAt"],
      "properties": {
        "id": { "type": "string", "description": "归一化（小写、去首尾标点）后的唯一键" },
        "word": { "type": "string" },
        "phonetic": { "type": "string" },
        "senses": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["pos", "cn"],
            "properties": {
              "pos": { "type": "string" },
              "cn": { "type": "string" }
            }
          }
        },
        "forms": { "type": "array", "items": { "type": "string" } },
        "collocations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["en", "cn"],
            "properties": {
              "en": { "type": "string" },
              "cn": { "type": "string" }
            }
          }
        },
        "source": {
          "type": "object",
          "required": ["articleId", "sentenceIdx"],
          "properties": {
            "articleId": { "type": "string" },
            "sentenceIdx": { "type": "integer", "minimum": 0 }
          }
        },
        "srs": { "$ref": "#/$defs/vocabSrsState" },
        "addedAt": { "type": "integer", "description": "Unix 毫秒" }
      }
    },
    "reviewLog": {
      "type": "object",
      "required": ["days"],
      "properties": {
        "days": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["day", "count"],
            "properties": {
              "day": { "type": "string", "description": "本地时区 YYYY-MM-DD" },
              "count": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "title": "reader_articles.json",
      "type": "object",
      "required": ["schemaVersion", "articles"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "articles": { "type": "array", "items": { "$ref": "#/$defs/article" } }
      }
    },
    {
      "title": "reader_vocab.json",
      "type": "object",
      "required": ["schemaVersion", "words", "reviewLog"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "words": { "type": "array", "items": { "$ref": "#/$defs/vocabWord" } },
        "reviewLog": { "$ref": "#/$defs/reviewLog" }
      }
    },
    {
      "title": "全局阅读设置（可选的跨平台同步单元）",
      "type": "object",
      "required": ["schemaVersion", "settings"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "settings": { "$ref": "#/$defs/readerSettings" }
      }
    }
  ]
}
