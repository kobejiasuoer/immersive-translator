{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://immersive-translator.local/contracts/reading-room.schema.json",
  "title": "沉浸阅读室数据契约（Mac / Windows 共享）",
  "description": "阅读室的文章、句对、生词（SRS）与阅读设置。Windows 落盘为 reader_articles.json / reader_vocab.json（顶层各带 schemaVersion），Mac 端按同一 schema 实现。",
  "version": "1.0.0",
  "$defs": {
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "description": "主版本号不同视为不兼容：读取方应向用户友好提示升级，不得静默失败或清空数据。"
    },
    "articleSourceType": {
      "type": "string",
      "enum": [
        "paste",
        "url",
        "epub",
        "pdf",
        "docx"
      ]
    },
    "sentenceZhState": {
      "type": "string",
      "enum": [
        "pending",
        "done",
        "failed",
        "edited"
      ]
    },
    "chunkType": {
      "type": "string",
      "enum": [
        "collocation",
        "phrasal",
        "idiom",
        "pattern"
      ],
      "description": "词块类型：搭配 / 短语动词 / 习语 / 句式框架"
    },
    "sentenceChunk": {
      "type": "object",
      "required": [
        "text",
        "chunkType",
        "gloss"
      ],
      "description": "句内标注的词块；text 必须是所在句 en 的连续子串",
      "properties": {
        "text": {
          "type": "string"
        },
        "chunkType": {
          "$ref": "#/$defs/chunkType"
        },
        "gloss": {
          "type": "string",
          "description": "中文释义（一句话）"
        },
        "pattern": {
          "type": "string",
          "description": "槽位记法，如 take on sth"
        },
        "trap": {
          "type": "string",
          "description": "直译陷阱，如 \"不是 make momentum\""
        }
      }
    },
    "sentencePair": {
      "type": "object",
      "required": [
        "idx",
        "paragraphIdx",
        "en",
        "zh",
        "zhState"
      ],
      "properties": {
        "idx": {
          "type": "integer",
          "minimum": 0,
          "description": "全文句序号，从 0"
        },
        "paragraphIdx": {
          "type": "integer",
          "minimum": 0
        },
        "en": {
          "type": "string"
        },
        "zh": {
          "type": [
            "string",
            "null"
          ],
          "description": "null = 尚未翻译"
        },
        "zhState": {
          "$ref": "#/$defs/sentenceZhState"
        },
        "revealed": {
          "type": "boolean",
          "description": "遮罩模式下是否已揭开"
        },
        "chunks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sentenceChunk"
          }
        }
      }
    },
    "articleProgress": {
      "type": "object",
      "required": [
        "sentenceIdx",
        "percent",
        "secondsListened"
      ],
      "properties": {
        "sentenceIdx": {
          "type": "integer",
          "minimum": 0
        },
        "percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "secondsListened": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "readerSettings": {
      "type": "object",
      "description": "文章记录里允许只携带部分字段（覆盖全局默认）；全局默认文件必须全量。",
      "required": [],
      "properties": {
        "contrastMode": {
          "type": "string",
          "enum": [
            "en",
            "dual",
            "zh"
          ]
        },
        "maskTranslation": {
          "type": "boolean"
        },
        "maskStyle": {
          "type": "string",
          "enum": [
            "blank",
            "frost"
          ],
          "description": "遮罩样式：blank=留白显影，frost=毛玻璃"
        },
        "showProgress": {
          "type": "boolean"
        },
        "zenMode": {
          "type": "boolean"
        },
        "theme": {
          "type": "string",
          "enum": [
            "light",
            "dark",
            "sepia",
            "oled"
          ]
        },
        "fontSize": {
          "type": "number",
          "minimum": 14,
          "maximum": 24
        },
        "lineHeight": {
          "type": "number",
          "minimum": 1,
          "maximum": 2.4
        },
        "fontPair": {
          "type": "string",
          "enum": [
            "serif",
            "sans"
          ]
        },
        "voice": {
          "type": "string",
          "description": "系统 TTS 音色名；空串 = 引擎默认"
        },
        "ttsProvider": {
          "type": "string",
          "enum": [
            "local",
            "xfyun"
          ],
          "description": "朗读引擎：local = 系统 SAPI（默认），xfyun = 讯飞在线合成"
        },
        "cloudVoice": {
          "type": "string",
          "description": "讯飞合成中文句发音人（vcn）；空串 = xiaoyan"
        },
        "cloudVoiceEn": {
          "type": "string",
          "description": "讯飞合成英文句发音人（vcn）；空串 = 回退 cloudVoice"
        },
        "rate": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2
        },
        "sentencePauseMs": {
          "type": "number",
          "minimum": 0,
          "maximum": 2000
        },
        "shadowingMode": {
          "type": "boolean"
        },
        "shadowingAssess": {
          "type": "boolean",
          "description": "跟读评测：跟读句送讯飞语音评测，达到阈值才放行"
        },
        "shadowingPassScore": {
          "type": "number",
          "minimum": 3,
          "maximum": 5,
          "description": "跟读过关阈值（5 分制），默认 4.2"
        },
        "shadowingAutoMic": {
          "type": "boolean",
          "description": "跟读评测开麦方式：true = 读完自动开麦（默认），false = 手动点「开口跟读」"
        },
        "shadowingSilenceMs": {
          "type": "number",
          "minimum": 800,
          "maximum": 3000,
          "description": "跟读评测静音断句时长（毫秒），默认 1500"
        },
        "chunkHighlight": {
          "type": "boolean",
          "description": "词块高亮：翻译完成后自动跑 LLM 词块标注"
        },
        "showVocabMarks": {
          "type": "boolean",
          "description": "生词再现标记：正文中标记已收藏的词/词块"
        },
        "reviewMode": {
          "type": "string",
          "enum": [
            "smart",
            "recognition",
            "cloze",
            "dictation"
          ],
          "description": "复习模式：smart 按卡路由到识别/完形/听写；只入全局默认，不进文章覆盖"
        }
      }
    },
    "article": {
      "type": "object",
      "required": [
        "id",
        "title",
        "titleCnState",
        "sourceType",
        "wordCount",
        "createdAt",
        "lastReadAt",
        "progress",
        "sentences"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "description": "英文标题"
        },
        "titleCn": {
          "type": "string",
          "description": "中文副标题"
        },
        "titleCnState": {
          "$ref": "#/$defs/sentenceZhState"
        },
        "sourceUrl": {
          "type": "string"
        },
        "sourceType": {
          "$ref": "#/$defs/articleSourceType"
        },
        "level": {
          "type": "string",
          "description": "如 \"B1 入门\""
        },
        "wordCount": {
          "type": "integer",
          "minimum": 0
        },
        "createdAt": {
          "type": "integer",
          "description": "Unix 毫秒"
        },
        "lastReadAt": {
          "type": "integer",
          "description": "Unix 毫秒"
        },
        "progress": {
          "$ref": "#/$defs/articleProgress"
        },
        "sentences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sentencePair"
          }
        },
        "chunkState": {
          "type": "string",
          "enum": [
            "pending",
            "done",
            "failed"
          ],
          "description": "词块标注进度；缺省 = 从未标注"
        },
        "settings": {
          "$ref": "#/$defs/readerSettings"
        }
      }
    },
    "vocabSrsState": {
      "type": "object",
      "required": [
        "ease",
        "intervalDays",
        "reps",
        "dueAt",
        "lapses"
      ],
      "properties": {
        "ease": {
          "type": "number"
        },
        "intervalDays": {
          "type": "number",
          "minimum": 0
        },
        "reps": {
          "type": "integer",
          "minimum": 0
        },
        "dueAt": {
          "type": "integer",
          "description": "Unix 毫秒；到期判定唯一依据"
        },
        "lapses": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "vocabWord": {
      "type": "object",
      "required": [
        "id",
        "word",
        "senses",
        "source",
        "srs",
        "addedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "归一化（小写、去首尾标点）后的唯一键"
        },
        "word": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "word",
            "chunk"
          ],
          "description": "生词条目类别；缺省视为 word（老数据无需迁移）"
        },
        "phonetic": {
          "type": "string"
        },
        "senses": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "pos",
              "cn"
            ],
            "properties": {
              "pos": {
                "type": "string"
              },
              "cn": {
                "type": "string"
              }
            }
          }
        },
        "forms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "chunkType": {
          "$ref": "#/$defs/chunkType",
          "description": "kind=chunk 时的词块类型"
        },
        "pattern": {
          "type": "string",
          "description": "槽位记法"
        },
        "trap": {
          "type": "string",
          "description": "直译陷阱"
        },
        "collocations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "en",
              "cn"
            ],
            "properties": {
              "en": {
                "type": "string"
              },
              "cn": {
                "type": "string"
              }
            }
          }
        },
        "source": {
          "type": "object",
          "required": [
            "articleId",
            "sentenceIdx"
          ],
          "properties": {
            "articleId": {
              "type": "string"
            },
            "sentenceIdx": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "srs": {
          "$ref": "#/$defs/vocabSrsState"
        },
        "addedAt": {
          "type": "integer",
          "description": "Unix 毫秒"
        },
        "example": {
          "type": "object",
          "description": "无文章来源（划词收藏）时的 LLM 例句，复习卡用作出语境",
          "required": [
            "en"
          ],
          "properties": {
            "en": {
              "type": "string",
              "description": "含目标词的英文例句"
            },
            "zh": {
              "type": [
                "string",
                "null"
              ],
              "description": "例句中文翻译"
            }
          }
        },
        "recall": {
          "anyOf": [
            {
              "$ref": "#/$defs/recallStat"
            },
            {
              "type": "null"
            }
          ],
          "description": "累计错题记录；缺省 = 无记录（老数据无需迁移）。"
        }
      }
    },
    "reviewLog": {
      "type": "object",
      "required": [
        "days"
      ],
      "properties": {
        "days": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "day",
              "count"
            ],
            "properties": {
              "day": {
                "type": "string",
                "description": "本地时区 YYYY-MM-DD"
              },
              "count": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "speakRole": {
      "type": "string",
      "enum": [
        "user",
        "assistant"
      ]
    },
    "speakScenarioId": {
      "type": "string",
      "enum": [
        "ordering",
        "interview",
        "travel",
        "smalltalk"
      ],
      "description": "口语陪练场景：点餐 / 面试 / 旅行 / 寒暄"
    },
    "speakDifficulty": {
      "type": "string",
      "enum": [
        "easy",
        "medium",
        "hard"
      ]
    },
    "speakShadowPhone": {
      "type": "object",
      "description": "音素级评测明细（ARPAbet 码 + GOP 惩罚）。",
      "required": [
        "content"
      ],
      "properties": {
        "content": {
          "type": "string",
          "description": "ARPAbet 音素码（dh / ih / ey …）"
        },
        "dpMessage": {
          "type": "integer",
          "description": "0 正常，非 0 异常标记"
        },
        "gwpp": {
          "type": "number",
          "description": "GOP 惩罚值，越负问题越大"
        }
      }
    },
    "speakShadowSyll": {
      "type": "object",
      "description": "音节级评测明细。",
      "required": [
        "content"
      ],
      "properties": {
        "content": {
          "type": "string"
        },
        "syllScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "serrMsg": {
          "type": "integer"
        },
        "phones": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/speakShadowPhone"
          }
        }
      }
    },
    "speakShadowWord": {
      "type": "object",
      "description": "词级评测明细（content 为识别词，位置是音频帧）。",
      "required": [
        "content"
      ],
      "properties": {
        "content": {
          "type": "string"
        },
        "totalScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 5,
          "description": "5 分制词分"
        },
        "dpMessage": {
          "type": "integer",
          "description": "0 正常 / 16 漏读 / 32 增读 / 64 回读 / 128 替换"
        },
        "sylls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/speakShadowSyll"
          }
        }
      }
    },
    "speakShadowAttempt": {
      "type": "object",
      "description": "一次跟读评测报告（分数均为 5 分制）。",
      "required": [
        "at",
        "total",
        "accuracy",
        "fluency",
        "integrity",
        "words"
      ],
      "properties": {
        "at": {
          "type": "integer",
          "description": "Unix 毫秒"
        },
        "total": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "accuracy": {
          "type": "number",
          "minimum": 0,
          "maximum": 5,
          "description": "准确度：每个音发得准不准"
        },
        "fluency": {
          "type": "number",
          "minimum": 0,
          "maximum": 5,
          "description": "流畅度：语速与停顿"
        },
        "integrity": {
          "type": "number",
          "minimum": 0,
          "maximum": 5,
          "description": "完整度：有没有漏词、添词"
        },
        "words": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/speakShadowWord"
          }
        }
      }
    },
    "speakTurn": {
      "type": "object",
      "required": [
        "role",
        "text",
        "at"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/speakRole"
        },
        "text": {
          "type": "string",
          "description": "user 轮为 ASR 转写；assistant 轮为英文回复"
        },
        "hintZh": {
          "type": "string",
          "description": "assistant 轮的中文提示（这句意思 + 怎么接话）"
        },
        "shadowScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 5,
          "description": "兼容字段：最新一次跟读总分（5 分制）；缺省 = 没测"
        },
        "shadowAttempts": {
          "type": "array",
          "description": "跟读报告历史（最新在末尾）；旧会话无此字段。",
          "items": {
            "$ref": "#/$defs/speakShadowAttempt"
          }
        },
        "at": {
          "type": "integer",
          "description": "Unix 毫秒"
        }
      }
    },
    "speakSession": {
      "type": "object",
      "required": [
        "id",
        "scenario",
        "difficulty",
        "turns",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "scenario": {
          "$ref": "#/$defs/speakScenarioId"
        },
        "difficulty": {
          "$ref": "#/$defs/speakDifficulty"
        },
        "turns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/speakTurn"
          }
        },
        "createdAt": {
          "type": "integer",
          "description": "Unix 毫秒"
        },
        "updatedAt": {
          "type": "integer",
          "description": "Unix 毫秒"
        }
      }
    },
    "recallModeStat": {
      "type": "object",
      "description": "单个复习模式下的错题计数（pass=通过 wrong=答错 trap=踩直译陷阱）。",
      "properties": {
        "pass": {
          "type": "integer",
          "minimum": 0
        },
        "wrong": {
          "type": "integer",
          "minimum": 0
        },
        "trap": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "pass",
        "wrong",
        "trap"
      ],
      "additionalProperties": false
    },
    "recallStat": {
      "type": "object",
      "description": "生词累计错题记录（每次复习判分后累加；复习笔记「为什么记不住」诊断的数据源）。",
      "properties": {
        "total": {
          "$ref": "#/$defs/recallModeStat"
        },
        "byMode": {
          "type": "object",
          "description": "键 = recallMode（recognition | cloze | dictation）。",
          "additionalProperties": {
            "$ref": "#/$defs/recallModeStat"
          }
        },
        "lastAt": {
          "type": "number",
          "description": "最近一次判分的 Unix 毫秒。"
        }
      },
      "required": [
        "total",
        "byMode"
      ],
      "additionalProperties": false
    },
    "noteReplay": {
      "type": "object",
      "description": "AI 复盘结果（存在笔记 md 的 JSON frontmatter 里，随文件自包含）。",
      "properties": {
        "rounds": {
          "type": "integer",
          "minimum": 1
        },
        "lastAt": {
          "type": "number"
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "stillWeak": {
          "type": "integer",
          "minimum": 0
        },
        "verdict": {
          "type": "string"
        },
        "weak": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "w": {
                "type": "string"
              },
              "why": {
                "type": "string"
              },
              "chip": {
                "type": "string",
                "description": "已废弃：UI 按实时错题统计现算着色；旧文件可能仍带此字段。"
              },
              "chipFair": {
                "type": "boolean",
                "description": "已废弃：同 chip。"
              }
            },
            "required": [
              "w",
              "why"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "rounds",
        "lastAt",
        "passed",
        "stillWeak",
        "verdict",
        "weak"
      ],
      "additionalProperties": false
    },
    "noteMeta": {
      "type": "object",
      "description": "复习笔记元数据（notes/学词笔记-*.md 头部的 JSON frontmatter；file 由存储层去重后生成）。",
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "file": {
          "type": "string"
        },
        "createdAt": {
          "type": "number"
        },
        "words": {
          "type": "integer",
          "minimum": 1
        },
        "partial": {
          "type": "boolean",
          "description": "生成被取消：只保存了已完成部分。"
        },
        "wordIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "replay": {
          "anyOf": [
            {
              "$ref": "#/$defs/noteReplay"
            },
            {
              "type": "null"
            }
          ]
        },
        "updatedAt": {
          "type": "number"
        }
      },
      "required": [
        "file",
        "createdAt",
        "words",
        "partial",
        "wordIds",
        "updatedAt"
      ]
    }
  },
  "oneOf": [
    {
