# Dependencies
node_modules/

# Build output
dist/
src-tauri/target/
src-tauri/gen/

# Logs
*.log
npm-debug.log*

# Editor
.vscode/
.idea/
*.swp
.DS_Store

# OCR 模型随安装包分发（tauri.conf.json bundle.resources），必须进仓库
test_ocr.png

# 更新签名密钥（绝不入仓库）
*-updater-keys*
*.sig

# 代码签名证书（自签开发证书的私钥与密码，绝不入仓库）
signing/

# 发布产物（构建后生成，通过 GitHub Release 分发，不入仓库）
release-v*/

# UI 静态预览稿（可由 scripts/gen-ui-preview.mjs 重新生成）
ui-preview.html
